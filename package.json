{
  "name": "sbom-diff-sentinel",
  "version": "1.1.0",
  "description": "SBOM diff gate: compares CycloneDX 1.4-1.6 / SPDX 2.3 SBOMs or git refs, reports added, removed, upgraded and downgraded components plus licence, supplier and hash changes, checks OSV.dev (cached, offline-capable) for new vs fixed vulns, honours VEX, and enforces policy. Text/JSON/SARIF/Markdown/PR comment, GitHub Action.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "sbom-diff-sentinel": "bin/sbom-diff-sentinel.js"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "action.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "build": "node scripts/build.mjs",
    "pretest": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "sbom",
    "sbom-diff",
    "cyclonedx",
    "spdx",
    "osv",
    "vulnerability",
    "supply-chain-security",
    "dependency-review",
    "license",
    "sarif",
    "cli",
    "github-action",
    "devsecops",
    "security"
  ],
  "author": "Louis Wright <hello@louiswright.co.uk> (https://github.com/MrLouisWright)",
  "license": "MIT",
  "funding": {
    "type": "stripe",
    "url": "https://donate.stripe.com/aFa00lek3cvX4Ds2Fk9EI0b"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrLouisWright/sbom-diff-sentinel.git"
  },
  "bugs": {
    "url": "https://github.com/MrLouisWright/sbom-diff-sentinel/issues"
  },
  "homepage": "https://mrlouiswright.github.io/sbom-diff-sentinel/",
  "dependencies": {
    "license-sentinel": "^1.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.8.2"
  }
}
